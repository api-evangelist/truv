              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Create a company."
        },
        {
          "info": {
            "name": "Retrieve a company.",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://prod.truv.com/v1/companies/:id/",
            "params": [
              {
                "name": "id",
                "value": "",
