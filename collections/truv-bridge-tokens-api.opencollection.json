                "description": "The ID of the user."
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Create a bridge token for a user."
        },
        {
          "info": {
            "name": "Create a link-access token.",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://prod.truv.com/v1/link-access-tokens/",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Create a link-access token."
        }
      ]
    }
  ],
  "bundled": true
}