{
  "opencollection": "1.0.0",
  "info": {
    "name": "Truv Admin Tasks API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "X-Access-Client-Id",
      "value": "{{X-Access-Client-Id}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Tasks",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List tasks.",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://prod.truv.com/v1/tasks/"
          },
          "docs": "List tasks."
        },
        {
          "info": {
            "name": "Retrieve a task.",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://prod.truv.com/v1/tasks/:id/",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "The ID of the resource."
              }
            ]
          },
          "docs": "Retrieve a task."
        }
      ]
    }
  ],
  "bundled": true
}